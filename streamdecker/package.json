{
  "name": "streamdecker",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:menubar && bun run src/main.ts",
    "build": "bun build src/main.ts --outdir=dist --target=bun",
    "build:menubar": "bash native/build-menubar.sh",
    "emulator": "bun run emulator/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^6.2.0",
    "@napi-rs/canvas": "^0.1.89",
    "sharp": "^0.33.5",
    "webview-bun": "^2.4.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@elgato/streamdeck": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
